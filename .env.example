# Copie este archivo a .env y ajuste los valores. Nunca suba .env al repositorio.
# Cualquier secreto puede darse tambien como archivo: CORE_<NOMBRE>_FILE=/run/secrets/<nombre>
# (Docker/Kubernetes secrets), asi no aparece en variables de entorno ni en 'docker inspect'.

# development | production (production exige secretos fuertes, TLS, PostgreSQL y Redis reales)
CORE_ENV=development
CORE_HOST=127.0.0.1
CORE_PORT=8080
CORE_LOG_LEVEL=INFO
# true carga la ruta C5 y tres buses de demostracion
CORE_SEED_DEMO=false

# --- Seguridad
# minimo 32 caracteres; obligatorio en produccion
CORE_JWT_SECRET=
CORE_JWT_ALGORITHM=HS256
CORE_PBKDF2_ITERATIONS=600000
# clave del hardware a bordo (cabecera X-Ingest-Key); minimo 32 caracteres en produccion
CORE_INGEST_KEY=
# lista separada por comas, por ejemplo https://app.ejemplo.co
CORE_CORS_ORIGINS=
# true solo detras de un proxy propio (usa X-Forwarded-For)
CORE_TRUST_PROXY=false
CORE_RATE_LIMIT_PER_MINUTE=120

# --- PostgreSQL (+ TimescaleDB): datos relacionales y serie temporal de telemetria
# Rol de ejecucion (core_app): solo DML. En produccion use sslmode=verify-full.
CORE_DATABASE_URL=postgresql://core_app:CAMBIAR@localhost:5432/core?sslmode=prefer
# Rol dueno del esquema (core_migrator): solo lo usan las migraciones al arrancar.
# Si se deja vacio, las migraciones se ejecutan con CORE_DATABASE_URL (solo desarrollo).
CORE_DATABASE_MIGRATION_URL=
CORE_DATABASE_SCHEMA=
CORE_DB_POOL_MIN=2
CORE_DB_POOL_MAX=10
CORE_DB_STATEMENT_TIMEOUT_MS=10000
# En produccion es true por defecto: el arranque falla si la extension timescaledb no esta activa.
CORE_TIMESCALE_REQUIRED=false
# En produccion es true por defecto: el arranque falla si PostGIS no esta activo (geometria de rutas y paradas).
CORE_POSTGIS_REQUIRED=false
# Telemetria cruda: se comprime tras N dias y se elimina tras M dias (el agregado de 5 min se conserva 365).
CORE_TELEMETRY_COMPRESS_AFTER_DAYS=7
CORE_TELEMETRY_RETENTION_DAYS=30

# --- Redis: estado en vivo, bloqueos, limites de peticiones, buzon de alertas, sesiones
# Con contrasena/ACL:  redis://usuario:clave@host:6379/0    Con TLS:  rediss://...
CORE_REDIS_URL=redis://localhost:6379/0
CORE_REDIS_USERNAME=
CORE_REDIS_PASSWORD=
# Alta disponibilidad con Sentinel (en lugar de CORE_REDIS_URL): host1:26379,host2:26379,host3:26379
CORE_REDIS_SENTINELS=
CORE_REDIS_SENTINEL_MASTER=mymaster
CORE_REDIS_SENTINEL_PASSWORD=
# Certificado de la autoridad que firma el de Redis (activa TLS)
CORE_REDIS_TLS_CA=
CORE_REDIS_PREFIX=core
CORE_REDIS_MAX_CONNECTIONS=50
# Solo desarrollo sin Redis: registro en archivo (una sola instancia)
CORE_DOC_STORE_PATH=

# --- Tiempo real (WebSocket /ws/v1/buses/stream)
# Segundos entre envios (v7: 3 a 5), conexiones por replica, rutas por conexion y cola por conexion.
CORE_WS_TICK_SECONDS=3
CORE_WS_MAX_CONNECTIONS=5000
CORE_WS_MAX_ROUTES=5
CORE_WS_OUTBOX_SIZE=16

# --- IA (opcional)
CORE_AI_ENABLED=false
# openai_compat = modelo abierto en su propio servidor (vLLM, Ollama, llama.cpp: API compatible con OpenAI). Recomendado.
# anthropic     = API alojada de Anthropic (opcional; necesita CORE_AI_API_KEY).
CORE_AI_PROVIDER=openai_compat
# Con openai_compat: la URL incluye /v1 y puede ser http si es un host privado (nombre de contenedor, localhost, IP privada).
#   Ollama:  http://localhost:11434/v1   |   vLLM:  http://llm:8000/v1
#   Amazon Bedrock (modelo abierto alojado en AWS, sin servidor propio):
#     CORE_AI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
#     CORE_AI_MODEL=openai.gpt-oss-120b-1:0      (o openai.gpt-oss-20b-1:0, más barato)
#     CORE_AI_API_KEY=<clave de API de Bedrock>   (consola de Bedrock > API keys; guárdela en Secrets Manager)
CORE_AI_BASE_URL=http://localhost:11434/v1
CORE_AI_MODEL=qwen3:8b
# La clave es opcional con servidores propios; obligatoria con Bedrock
CORE_AI_API_KEY=
CORE_AI_TIMEOUT_SECONDS=120

# --- Notificaciones
# correos del equipo tecnico, separados por comas
CORE_TEAM_EMAILS=
CORE_SMTP_HOST=
CORE_SMTP_PORT=587
CORE_SMTP_USER=
CORE_SMTP_PASSWORD=
CORE_SMTP_SENDER=no-responder@capacidadbus.co
# ruta del JSON de cuenta de servicio (push real); vacio = solo registro en log
CORE_FIREBASE_CREDENTIALS=

# --- Despliegue sin servidor (Vercel): ver docs/vercel-deploy.md
# Aplicar el esquema en el despliegue (python -m core_service migrate) y no al arrancar cada funcion
CORE_DB_MIGRATE_ON_START=true
# Detras de PgBouncer / endpoint "pooled" de Neon: sin sentencias preparadas ni opciones de arranque
CORE_DB_PREPARE=true
CORE_DB_STARTUP_OPTIONS=true
# false cuando no hay un proceso siempre encendido (las tareas periodicas las llama un cron)
CORE_RUN_JOBS=true
# Secreto del programador de tareas: GET /api/v1/internal/jobs/run con "Authorization: Bearer <secreto>".
# Vercel Cron envia ese encabezado con la variable CRON_SECRET (tambien se acepta con ese nombre).
CORE_CRON_SECRET=
